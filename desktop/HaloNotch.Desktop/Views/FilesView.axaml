<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="using:HaloNotch"
             xmlns:v="using:HaloNotch.Views"
             x:Class="HaloNotch.Views.FilesView"
             x:DataType="h:FileTrayStore">
  <UserControl.Resources>
    <ContextMenu x:Key="FileMenu" x:DataType="h:FileEntry" Opened="OnMenuOpened" Closed="OnMenuClosed">
      <MenuItem x:Name="OpenItem" Header="{x:Static v:FilesView.OpenText}" Click="OnOpen" />
      <MenuItem Header="{x:Static v:FilesView.RevealText}" Click="OnReveal" />
      <MenuItem Header="{x:Static v:FilesView.CopyText}" Click="OnCopy" />
      <MenuItem Header="{x:Static v:FilesView.RemoveText}" Click="OnRemove" />
    </ContextMenu>
  </UserControl.Resources>
  <Grid ColumnDefinitions="*,280" ColumnSpacing="14">
    <!-- Tray -->
    <Panel>
      <Panel IsVisible="{Binding IsEmpty}">
        <Rectangle RadiusX="16" RadiusY="16" Stroke="#40FFFFFF" StrokeThickness="1.5" StrokeDashArray="4,3" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <TextBlock Classes="icon" Text="&#xF151;" FontSize="30" HorizontalAlignment="Center" />
          <TextBlock x:Name="DropHint" Classes="secondary" HorizontalAlignment="Center" />
        </StackPanel>
      </Panel>
      <Border Classes="card" IsVisible="{Binding !IsEmpty}">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding CountText}" Classes="caps" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="CopyAllButton" Classes="chip" Click="OnCopyAll" />
            <Button Grid.Column="2" x:Name="ClearButton" Classes="chip" Click="OnClear" />
          </Grid>
          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Files}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="h:FileEntry">
                  <Button Classes="row" Width="110" Height="110" Margin="0,0,8,8" Background="{StaticResource Fill}"
                          DoubleTapped="OnOpenTapped" ContextMenu="{StaticResource FileMenu}"
                          ToolTip.Tip="{Binding Path}">
                    <Grid RowDefinitions="*,Auto" RowSpacing="4">
                      <Panel>
                        <TextBlock Classes="icon" Text="{Binding Glyph}" FontSize="32" HorizontalAlignment="Center" Foreground="{StaticResource Accent}" />
                        <Border CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Image Source="{Binding Thumbnail}" MaxHeight="64" Stretch="Uniform" />
                        </Border>
                      </Panel>
                      <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Panel>

    <!-- Screenshots shelf -->
    <Border Grid.Column="1" Classes="card" x:DataType="h:ScreenshotStore" DataContext="{x:Static h:Hub.Screenshots}">
      <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="icon" Text="&#xF255;" />
          <TextBlock x:Name="ShotsTitle" Classes="caps" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Row="1" x:Name="ShotsEmpty" Classes="tertiary" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Shots}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="h:FileEntry">
                <Button Classes="plain" Margin="0,0,6,6" Click="OnShotOpen" ToolTip.Tip="{Binding Name}">
                  <Button.ContextMenu>
                    <ContextMenu Opened="OnMenuOpened" Closed="OnMenuClosed">
                      <MenuItem Header="{x:Static v:FilesView.CopyText}" Click="OnShotCopy" />
                      <MenuItem Header="{x:Static v:FilesView.RevealText}" Click="OnShotReveal" />
                      <MenuItem Header="{x:Static v:FilesView.TrashText}" Click="OnShotTrash" />
                    </ContextMenu>
                  </Button.ContextMenu>
                  <Border CornerRadius="8" ClipToBounds="True" Height="70" Background="{StaticResource Fill}">
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
