<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="using:HaloNotch"
             x:Class="HaloNotch.Views.VaultView"
             x:DataType="h:VaultStore">
  <Border Classes="card">
    <Panel>
      <!-- Setup / locked -->
      <StackPanel IsVisible="{Binding !IsUnlocked}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Width="360">
        <TextBlock Classes="icon" FontSize="26" Text="&#xE72E;" HorizontalAlignment="Center" Foreground="{StaticResource Accent}" />
        <TextBlock x:Name="Intro" TextWrapping="Wrap" TextAlignment="Center" Classes="secondary" FontSize="12" />
        <TextBox x:Name="PassBox" PasswordChar="•" Classes="search" Text="{Binding Passcode}" KeyDown="OnPassKey" />
        <TextBox x:Name="ConfirmBox" PasswordChar="•" Classes="search" Text="{Binding Confirm}" IsVisible="{Binding IsSetup}" KeyDown="OnPassKey" />
        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#FF6B6B" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
        <Button x:Name="MainButton" Classes="pill" HorizontalAlignment="Center" Click="OnMain" IsEnabled="{Binding !Busy}" />
        <Button x:Name="EraseButton" Classes="plain" HorizontalAlignment="Center" IsVisible="{Binding IsLocked}" Click="OnErase">
          <TextBlock x:Name="EraseText" Classes="tertiary small" />
        </Button>
      </StackPanel>

      <!-- Unlocked -->
      <Grid IsVisible="{Binding IsUnlocked}" ColumnDefinitions="260,*" ColumnSpacing="14">
        <StackPanel Spacing="8">
          <TextBox x:Name="LabelBox" Classes="search" Text="{Binding DraftLabel}" />
          <TextBox x:Name="SecretBox" Classes="search" PasswordChar="•" Text="{Binding DraftSecret}" KeyDown="OnAddKey" />
          <TextBlock x:Name="MoveHint" Classes="tertiary small" TextWrapping="Wrap" IsVisible="{Binding HasPendingMove}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="AddButton" Classes="pill" Click="OnAdd" />
            <Button x:Name="LockButton" Classes="chip" Click="OnLock" />
          </StackPanel>
          <TextBlock x:Name="Footnote" Classes="tertiary small" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#FF6B6B" FontSize="11" />
        </StackPanel>
        <Panel Grid.Column="1">
          <TextBlock x:Name="EmptyText" Classes="tertiary" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Entries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="h:VaultEntry">
                  <Border Background="{StaticResource Fill}" CornerRadius="10" Padding="10,6" Margin="0,0,0,4">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{Binding Shown}" Classes="secondary" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Classes="icon" Content="&#xE890;" Click="OnReveal" />
                        <Button Classes="icon" Content="{Binding Copied, Converter={x:Static h:Conv.CopyGlyph}}" Click="OnCopy" />
                        <Button Classes="icon" Content="&#xE74D;" Click="OnRemove" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Panel>
      </Grid>
    </Panel>
  </Border>
</UserControl>
