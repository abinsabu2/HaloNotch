<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HaloNotch.SettingsWindow"
        Width="640" Height="600" CanResize="False" WindowStartupLocation="CenterScreen"
        Background="#1C1C1E" Icon="avares://HaloNotch/Assets/AppIcon.ico">
  <Window.Styles>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="15" /><Setter Property="MinHeight" Value="40" /><Setter Property="Padding" Value="14,0" /></Style>
    <Style Selector="StackPanel.page"><Setter Property="Margin" Value="24,16" /><Setter Property="Spacing" Value="10" /></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,10,0,0" /></Style>
    <Style Selector="TextBlock.note"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{StaticResource Secondary}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  </Window.Styles>
  <TabControl x:Name="Tabs" Padding="0">
    <TabItem x:Name="GeneralTab">
      <ScrollViewer><StackPanel x:Name="GeneralPage" Classes="page" /></ScrollViewer>
    </TabItem>
    <TabItem x:Name="DashboardTab">
      <ScrollViewer><StackPanel x:Name="DashboardPage" Classes="page" /></ScrollViewer>
    </TabItem>
    <TabItem x:Name="WeatherTab">
      <ScrollViewer><StackPanel x:Name="WeatherPage" Classes="page" /></ScrollViewer>
    </TabItem>
    <TabItem x:Name="CalendarTab">
      <ScrollViewer><StackPanel x:Name="CalendarPage" Classes="page" /></ScrollViewer>
    </TabItem>
    <TabItem x:Name="ScreenTimeTab">
      <ScrollViewer><StackPanel x:Name="ScreenTimePage" Classes="page" /></ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
